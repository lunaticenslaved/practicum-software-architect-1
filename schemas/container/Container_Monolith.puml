@startuml Container_Monolith
title SmartHome Container Diagram

top to bottom direction

!include https://raw.githubusercontent.com/RicardoNiepel/C4-PlantUML/master/C4_Component.puml

Person(user, "User", "A user of the system")
Person(sensor, "Sensor", "aka Temperature API")

System(SmartHomeSystem, "SmartHome System", "System managing sensors and temperature")

Container_Boundary(SmartHomeSystem, "SmartHome System") {
  Container(Monolith, "Monolith", "Go", "Manages sensors, temperatures and others")
  Container(MobileApp, "Mobile Application", "Kotlin, Swift", "Allows users to manage their home")
  ContainerDb(Database, "Database", "PostgreSQL", "")
}

Rel(user, MobileApp, "Uses mobile app to manages home heating")
Rel(Monolith, sensor, "Manages sensors while user commands")
Rel(Monolith, Database, "Reads and writes data")
Rel(MobileApp, Monolith, "Uses API")

@enduml
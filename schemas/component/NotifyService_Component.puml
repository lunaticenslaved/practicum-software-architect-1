@startuml
title SmartHome Web Application Component Diagram

top to bottom direction

!includeurl https://raw.githubusercontent.com/RicardoNiepel/C4-PlantUML/master/C4_Component.puml

Boundary(SmartHomeSystem, "SmartHome System") {
  Container(NotifyService, "NotifyService", "Node.js", "")
  Container(MessageBus, "MessageBus", "Kafka", "Handles events")
}

System_Ext(notificationAPI, "Notification API", "External API for notifications")

Container(NotifyService, "NotifyService", "Node.js", "") {
  Component(MessageBusSubscriber, "MessageBusSubscriber", "Receives messages")
  Component(BusinessLogic, "Business Logic", "Business logic")
}

Rel(MessageBus, MessageBusSubscriber, "Sends messages")
Rel(MessageBusSubscriber, BusinessLogic, "Call business logic")
Rel(BusinessLogic, notificationAPI, "Calls external APIs")

@enduml